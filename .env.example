# ─────────────────────────────────────────────────────────────
# 1) Formulario web (seguro para el navegador)
#    Usa la llave "anon" / "publishable" del proyecto Supabase.
#    Esta llave NO puede leer los CV: solo ejecuta la función submit_cv.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# ─────────────────────────────────────────────────────────────
# 2) Solo para tus scripts locales (NUNCA en el navegador)
#    Project Settings → API → service_role key.
#    Se usa únicamente en `node scripts/cvadmin.mjs ...`.
#    Si la dejas vacía, el formulario funciona igual, pero no
#    podrás listar/exportar los CV desde la terminal.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# Nombre visible del servicio (opcional)
VITE_SERVICE_NAME=CVDigital
