{
    "name":  "cvdigital-formulario",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "description":  "Formulario web de recolección de información para la creación de hojas de vida (CVDigital + Supabase)",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc -b && vite build",
                    "preview":  "vite preview --port 4173",
                    "typecheck":  "tsc -b",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "qa":  "node qa/visual.mjs",
                    "db:verify":  "node scripts/cvadmin.mjs verify",
                    "db:list":  "node scripts/cvadmin.mjs list",
                    "db:show":  "node scripts/cvadmin.mjs show",
                    "db:export":  "node scripts/cvadmin.mjs export",
                    "db:smoke":  "node scripts/cvadmin.mjs smoke",
                    "test:sql":  "node qa/sql-smoke.mjs",
                    "test:security":  "node qa/security.mjs"
                },
    "dependencies":  {
                         "@hookform/resolvers":  "^5.2.2",
                         "@supabase/supabase-js":  "^2.58.0",
                         "clsx":  "^2.1.1",
                         "lucide-react":  "^0.545.0",
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0",
                         "react-hook-form":  "^7.65.0",
                         "zod":  "^4.1.12"
                     },
    "devDependencies":  {
                            "@electric-sql/pglite":  "^0.5.14",
                            "@tailwindcss/vite":  "^4.1.14",
                            "@types/node":  "^26.6.6",
                            "@types/react":  "^19.2.0",
                            "@types/react-dom":  "^19.2.0",
                            "@vitejs/plugin-react":  "^5.0.4",
                            "playwright":  "^1.64.1",
                            "tailwindcss":  "^4.1.14",
                            "typescript":  "^5.9.3",
                            "vite":  "^7.1.9",
                            "vitest":  "^3.2.4"
                        }
}
